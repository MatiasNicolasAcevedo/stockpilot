# Ejemplo de configuración local de StockPilot. Copiar a .env (ignorado por Git) solo si hace falta
# cambiar algún valor: docker-compose.yml ya trae estos mismos defaults. Valores ficticios de desarrollo;
# nunca poner aquí credenciales reales.

# Base de datos de desarrollo (volumen persistente stockpilot_db-data)
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot-dev-only

# Puertos publicados solo en loopback (127.0.0.1) del host
DB_PORT=55432
# Only compose.diagnostic.yml publishes the server; forwarding is disabled there.
DIAGNOSTIC_SERVER_PORT=8080
# Origen público del navegador (client: SPA + proxy a server) y desarrollo con HMR (perfil dev)
CLIENT_PORT=5173
CLIENT_DEV_PORT=5174
APP_PUBLIC_URL=http://127.0.0.1:5173

# OpenAPI/Swagger UI (ADR 0003): false por defecto. true solo para desarrollo local con APP_PUBLIC_URL HTTP
# loopback (localhost, 127.0.0.1, [::1]); con HTTPS u otro host el server no arranca. Publica únicamente
# GET ${APP_PUBLIC_URL}/api/docs/swagger-ui.html y /api/docs/openapi. Ver docs/SETUP.md.
STOCKPILOT_API_DOCS_ENABLED=false

# Runner de pruebas backend (scripts/verify.sh): container | host
# container = Testcontainers desde el contenedor server-tests (camino por defecto)
# host      = alternativa preaprobada: ./mvnw clean verify con el JDK 21 del host (ver docs/TESTING.md)
STOCKPILOT_SERVER_TESTS=container

# Google real: values must be supplied privately to the backend; empty defaults fail without mock fallback.
# This versioned example NEVER contains real credentials. Owner setup and smoke: docs/SETUP.md (S-03 guide).
# Authorized redirect URI must be exactly ${APP_PUBLIC_URL}/login/oauth2/code/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# To use Vite HMR auth, choose APP_PUBLIC_URL=http://127.0.0.1:5174 for server AND proxy.
# One public origin at a time. Provider mock is exclusive to compose.auth-test.yml/test/e2e.
